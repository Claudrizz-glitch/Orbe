# ─────────────────────────────────────────────────────────────
# ORBE — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure também na Vercel.
# NUNCA versione valores reais. Nenhuma destas variáveis vai para o navegador.
# ─────────────────────────────────────────────────────────────

# URL do projeto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave secreta do Supabase (Project Settings → API Keys → "secret" sb_secret_...
# ou a antiga "service_role"). Usada SOMENTE no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Hash da senha de acesso ao ORBE. Gere com:
#   npm run hash-password
# e cole o resultado aqui (formato scrypt:N:r:p:salt:hash). A senha em si
# nunca é armazenada.
ORBE_PASSWORD_HASH=

# Segredo aleatório usado para anonimizar IPs no limitador de tentativas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORBE_SESSION_SECRET=
